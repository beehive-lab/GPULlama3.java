digraph GPULlamaArchitecture {
  graph [
    label="GPULlama3.java Architecture",
    labelloc=t,
    fontsize=24,
    fontname="Helvetica Bold",
    bgcolor="white",
    pad=0.30,
    nodesep=0.38,
    ranksep=0.52,
    splines=ortho,
    compound=true
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#334155",
    fontcolor="#0f172a",
    penwidth=1.2,
    margin="0.14,0.09"
  ];
  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#475569",
    fontcolor="#334155",
    arrowsize=0.75,
    penwidth=1.1
  ];

  integrations [label="Applications & Integrations\nCLI · OpenAI server · LangChain4j · Quarkus", fillcolor="#dbeafe"];
  api [label="Public API\nLocalModels · LocalModel · GenerationSession\nrequests · conversations · tools · token events", fillcolor="#bfdbfe"];
  generation [label="Generation\nprompt ingestion · stop policy · detokenization · sampling", fillcolor="#e0e7ff"];
  engine [label="Optional Engine Tier\nrequest scheduling · admission · batch composition\nprefix reuse · serving metrics", fillcolor="#ddd6fe"];

  subgraph cluster_model_runtime {
    label="Model and Runtime";
    fontname="Helvetica Bold";
    fontsize=12;
    color="#94a3b8";
    style="rounded,dashed";
    margin=16;

    model [label="Loaded Model (shared, immutable)\narchitecture · configuration · weights\ntokenizer · chat format", fillcolor="#dcfce7"];
    session [label="Session (one sequence)\nposition · conversation · sampler · KV lease", fillcolor="#dcfce7"];
    kv [label="KV & Memory Runtime\nblock pool · leases · shared workspace\nmemory plan · lifecycle", fillcolor="#d1fae5"];
    providers [label="Provider SPIs (ServiceLoader)\nmodel recognition · architecture description\nCPU forward · Tornado plan/lowering · KV storage", fillcolor="#ecfccb"];
  }

  subgraph cluster_program {
    label="Backend-neutral Program";
    fontname="Helvetica Bold";
    fontsize=12;
    color="#94a3b8";
    style="rounded,dashed";
    margin=16;

    program [label="InferenceProgram + ProgramSignature\nordered components · phases · fixed bindings\ninvocation values · host-visible results", fillcolor="#fef3c7"];
    operations [label="Operation Vocabulary\nRMSNorm · RoPE · MatVec/MatMul · Attention\nKV append · activations · residual · projection · sampling", fillcolor="#fde68a"];
    policy [label="Resolved Execution Policy\nmode · prefill batch · sampling residency\nstorage and compile options", fillcolor="#fef9c3"];
  }

  backend_spi [label="Backend & Device SPI\ndevice selection · capabilities · capacity\ncompile · execute · buffer lifetimes", fillcolor="#fed7aa"];

  subgraph cluster_backends {
    label="Backend Implementations";
    fontname="Helvetica Bold";
    fontsize=12;
    color="#94a3b8";
    style="rounded,dashed";
    margin=16;

    cpu [label="CPU Backend\nplain Java · Vector API\nformat-decoded K-quant kernels", fillcolor="#f1f5f9"];
    lowering [label="TornadoVM Lowering\nfusion · kernel selection · task graphs\ngrid schedulers · fixed device workspace", fillcolor="#fecaca"];
    cache [label="Compiled-program Cache\ncompile once · execute many\nkeyed by program, device, options and binding domain", fillcolor="#fee2e2"];
    tornadovm [label="TornadoVM Runtime\nTornadoExecutionPlan · persistent device buffers", fillcolor="#fca5a5"];
  }

  devices [label="Execution Targets\nCPU  |  CUDA  |  OpenCL  |  Metal", fillcolor="#e2e8f0"];
  metrics [label="Diagnostics & Metrics\nstable codes · execution-path evidence · timings", fillcolor="#cffafe"];

  integrations -> api [label="load / open session / generate"];
  api -> generation;
  generation -> engine [label="optional multi-request path"];
  generation -> session [label="single-session path"];
  engine -> session [label="schedules"];
  api -> model [label="owns handle"];
  model -> session [label="opens"];
  session -> kv [label="leases"];
  model -> providers [label="recognized & loaded by"];
  providers -> program [label="describes"];
  session -> program [label="selects"];
  policy -> program [label="shapes signature"];
  operations -> program [dir=back, label="composed into"];
  program -> backend_spi [label="compile"];
  kv -> backend_spi [label="storage identity & capacity"];
  backend_spi -> cpu;
  backend_spi -> lowering;
  lowering -> cache [label="produces"];
  cache -> tornadovm [label="invokes"];
  cpu -> devices;
  tornadovm -> devices;

  backend_spi -> metrics [style=dashed, label="reports"];
  generation -> metrics [style=dashed, label="request metrics"];

  invariant [
    shape=note,
    label="Key invariants\n• TornadoVM types stay inside backend/tornado\n• backends own lowering, fusion and materialization\n• fixed bindings are never rebound\n• no compilation or allocation per token\n• unsupported combinations never silently fall back\n• numerical claims use CPU reference",
    fillcolor="#f8fafc",
    color="#64748b",
    fontsize=9
  ];
  { rank=same; devices; invariant; }
}
